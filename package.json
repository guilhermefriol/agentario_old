{
  "name": "pixel_room",
  "version": "0.1.0",
  "private": true,
  "description": "Painel de TV só-leitura: escritório pixel art dos agentes Claude Code",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/pixel_room.mjs",
    "test": "node --test test/*.test.mjs",
    "demo": "node bin/demo.mjs",
    "visual": "playwright test -c test/visual/playwright.config.mjs",
    "visual:update": "playwright test -c test/visual/playwright.config.mjs --update-snapshots"
  },
  "author": "Guilherme Friol",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
